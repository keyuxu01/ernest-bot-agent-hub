{
  "name": "ernest-bot-agent-pub",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "cz": "git-cz",
    "agent:sync": "rulesync install --frozen && rulesync generate",
    "agent:update": "rulesync install --update && rulesync generate",
    "agent:check": "rulesync generate --check",
    "docker:setup:prod": "test -f .env.prod.local || cp .env.prod.example .env.prod.local",
    "docker:up": "podman compose --env-file .env.dev up -d --build",
    "docker:up:prod": "pnpm docker:setup:prod && docker compose --env-file .env.prod.example --env-file .env.prod.local up -d --build",
    "docker:down": "podman compose --env-file .env.dev down",
    "docker:down:prod": "docker compose --env-file .env.prod.example --env-file .env.prod.local down",
    "docker:logs": "podman compose --env-file .env.dev logs -f",
    "docker:ps": "podman compose --env-file .env.dev ps",
    "docker:clean": "podman compose --env-file .env.dev down -v && rm -rf ./volumes"
  },
  "devDependencies": {
    "commitizen": "^4.3.1",
    "cz-emoji": "1.3.2-canary.2",
    "prettier": "3.9.6",
    "rulesync": "^8.31.0",
    "turbo": "^2.10.12",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-emoji"
    }
  }
}
