{
  "name": "ernest-bot-agent-pub",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "cz": "git-cz",
    "agent:sync": "rulesync install --frozen && rulesync generate",
    "agent:update": "rulesync install --update && rulesync generate",
    "agent:check": "rulesync generate --check"
  },
  "devDependencies": {
    "commitizen": "^4.3.1",
    "cz-emoji": "1.3.2-canary.2",
    "prettier": "3.9.6",
    "rulesync": "^8.31.0",
    "turbo": "^2.10.12",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-emoji"
    }
  }
}
