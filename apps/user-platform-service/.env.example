# UserPlatform identity boundary. Never commit real credentials.
PORT=9040
SERVICE_VERSION=development
SERVICE_BUILD_ID=local

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=user
POSTGRES_PASSWORD=
POSTGRES_DB=agent_hub
POSTGRES_SCHEMA=user_platform
POSTGRES_POOL_SIZE=5
POSTGRES_SSL=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ISSUER=https://accounts.google.com
GOOGLE_AUTHORIZATION_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
OAUTH_ALLOWED_REDIRECT_URIS=http://127.0.0.1:49152/callback
OAUTH_STATE_TTL_SECONDS=300

SIGNING_KEY_ID=
SIGNING_PRIVATE_KEY=
SIGNING_PUBLIC_KEY=
TOKEN_ALGORITHM=EdDSA
TOKEN_ISSUER=https://identity.example.test
TOKEN_AUDIENCE=assistant-runtime
ACCESS_TOKEN_TTL_SECONDS=300

ENCRYPTION_KEY_ID=
ENCRYPTION_MASTER_KEY=
