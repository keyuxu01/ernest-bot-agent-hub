# 模板：复制为 .env.dev。生产再写 .env.prod，同名变量覆盖 .env.dev。
# 这两份都不进 git。
PORT=9020

# PostgreSQL：文档元数据。生产环境必须使用独立凭据。
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=user
POSTGRES_PASSWORD=123456
POSTGRES_DB=agent_hub

# MongoDB：文档正文。使用 init-scripts 创建的应用账号，而不是 root 账号。
MONGO_URI=mongodb://agent_hub:agent_hub_password@localhost:27017/knowledge_hub?authSource=knowledge_hub

# snowflake-id@1.1.0 的稳定 worker 范围为 1-1022；并发实例必须使用不同值。
SNOWFLAKE_WORKER_ID=1

# 自定义纪元（毫秒）。产生持久化 ID 后不得随意修改。
SNOWFLAKE_OFFSET=1704067200000

# RustFS（S3 兼容对象存储）。生产环境必须使用独立凭据。
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_REGION=us-east-1
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
RUSTFS_BUCKET=knowledge-hub
RUSTFS_PUBLIC_URL=http://localhost:9000

# RabbitMQ（文档发布后异步 RAG）。guest 仅适合本地。
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Elasticsearch（RAG 向量索引）
ELASTICSEARCH_NODE=http://localhost:9200

# RAG 分块（token 数；实现按 1 token ≈ 2 字符换算）
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64

# 通义千问 Embedding（DashScope OpenAI 兼容接口，不是 OpenAI）
QWEN_LLM_API_KEY=sk-xxx
QWEN_CODER_TURBO_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDINGS_MODEL_NAME=text-embedding-v4
EMBEDDING_DIMENSION=1024
# DashScope 单次上限 10，配错会在请求时失败
EMBEDDING_BATCH_SIZE=10

# RAG 混合检索（/rag/search、/ai/chat：关键词 + 向量 → RRF → rerank）
RAG_HYBRID_TOP_K=20
RAG_RRF_C=60
# 精排（DashScope text-rerank，复用 QWEN_LLM_API_KEY）；也可用百炼业务空间地址
QWEN_RERANK_MODEL_NAME=qwen3-rerank
QWEN_RERANK_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
# AI_CHAT_TIMEOUT_MS=60000

# 通义千问对话模型（KG 实体关系抽取与 RAG 问答；复用上面的 QWEN_LLM_API_KEY / BASE_URL）
CHAT_MODEL_NAME=qwen-plus
# qwen-plus + 完整抽取 prompt 常超过 20s；超时后不重试，该块只落节点不落实体
CHAT_MODEL_TIMEOUT_MS=120000

# Neo4j（KG 知识图谱）。连不上会阻断启动；密码与根目录 .env 的 NEO4J_PASSWORD 一致
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=12345678

# 文档发布审核（可选，默认 true）。true：publish 进入待审，审核通过后才建索引；
# false：publish 直接发布。只接受 true / false，拼错会阻断启动
DOCUMENT_REQUIRE_APPROVAL=true

# JWT 鉴权（用户模块）。JWT_SECRET 必填，生产用 `openssl rand -base64 48` 生成，更换会使全部 token 失效
JWT_SECRET=dev-secret-change-me-in-production
# 有效期（可选，缺省 2h / 7d），格式：数字 + s/m/h/d
JWT_ACCESS_EXPIRES=2h
JWT_REFRESH_EXPIRES=7d
# 初始管理员（可选，三项须同时配置）：启动时若不存在则创建，拥有 ROLE_ADMIN + ROLE_REVIEWER；
# 已存在不会重置密码、不改邮箱。首次启动后可删除这三项
# AUTH_BOOTSTRAP_ADMIN_USERNAME=admin
# AUTH_BOOTSTRAP_ADMIN_PASSWORD=
# AUTH_BOOTSTRAP_ADMIN_EMAIL=

# 邮箱验证（默认 false：注册后立即可登录；true 时需邮件激活）
REQUIRE_EMAIL_VERIFICATION=false
# 激活链接前缀，需指向本服务（默认端口 9020）
APP_PUBLIC_URL=http://localhost:9020

# SMTP 邮件（@nestjs-modules/mailer + nodemailer）：激活邮件、密码重置验证码
MAIL_HOST=smtp.qq.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=xx@xx.com
MAIL_PASS=xx
MAIL_FROM="Knowledge Hub <xx@xx.com>"

# Redis（密码重置验证码、邮箱激活令牌）；与根目录 compose 的 redis 服务对应
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
