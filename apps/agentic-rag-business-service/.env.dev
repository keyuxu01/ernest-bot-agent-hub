# 本地默认（可提交）。个人覆盖用同目录 .env.local（gitignore）。
# 启动：pnpm --filter agentic-rag-business-service dev（Nest ConfigModule 会加载本文件）

PORT=9020

# PostgreSQL：文档元数据（与仓库根 .env.dev / Compose 一致）
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=user
POSTGRES_PASSWORD=123456
POSTGRES_DB=agent_hub

# MongoDB：文档正文（init-scripts 创建的应用账号）
MONGO_URI=mongodb://agent_hub:agent_hub_password@localhost:27017/knowledge_hub?authSource=knowledge_hub

# snowflake-id@1.1.0 worker 范围 1–1022；多实例部署时每副本不同 ID
SNOWFLAKE_WORKER_ID=1

# 自定义纪元（毫秒）；已有持久化 ID 后勿改
SNOWFLAKE_OFFSET=1704067200000
