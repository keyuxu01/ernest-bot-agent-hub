# Assistant Runtime application configuration.
# Copy to .env.dev for local development. Never commit real credentials.

# HTTP
NODE_ENV=development
PORT=9030
SERVICE_VERSION=development
SERVICE_BUILD_ID=local

# 本地开发直接连接仓库内的 MCP 服务；生产和远程 MCP 必须使用 HTTPS。
MCP_COLLECTIONS_URL=http://localhost:9021
MCP_REQUEST_TIMEOUT_MS=30000

# PostgreSQL — durable source of truth for Sessions, Runs, Events and checkpoints.
# Local Podman Compose exposes the shared postgres service on localhost:5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=user
POSTGRES_PASSWORD=
POSTGRES_DB=agent_hub
POSTGRES_SCHEMA=assistant_runtime
POSTGRES_POOL_SIZE=10
POSTGRES_SSL=false

# Redis — reconstructable hot state, leases, fencing coordination and SSE fan-out.
# Use rediss:// in production when the provider requires TLS.
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=agent-hub:assistant:v1:
REDIS_HOT_STATE_TTL_SECONDS=1800
REDIS_LEASE_TTL_MS=15000
REDIS_LEASE_RENEW_INTERVAL_MS=5000
REDIS_COMMAND_TIMEOUT_MS=5000

# Mem0 — extracted long-term facts; never conversation history or checkpoints.
# Phase 1 supports managed Platform only; MEM0_BASE_URL is rejected.
MEM0_MODE=platform
MEM0_API_KEY=
MEM0_AGENT_ID=agent-hub-assistant
MEM0_TOP_K=5
MEM0_REQUEST_TIMEOUT_MS=10000
MEM0_EXTRACTION_ENABLED=true

# Object storage — artifacts and large/binary tool results.
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=assistant-artifacts
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_REQUEST_TIMEOUT_MS=10000

# Envelope encryption references. Production values come from secret management.
ENCRYPTION_KEY_ID=
ENCRYPTION_MASTER_KEY=

# Runtime verifies UserPlatform access grants locally.
TOKEN_ALGORITHM=EdDSA
TOKEN_ISSUER=https://identity.example.test
TOKEN_AUDIENCE=assistant-runtime
TOKEN_PUBLIC_KEY=
TOKEN_KEY_ID=

# Provider execution and public exposure limits.
MODEL_REQUEST_TIMEOUT_MS=120000
MODEL_MAX_ATTEMPTS=3
MAX_REQUEST_BYTES=1048576
MAX_STREAM_SECONDS=300
MAX_CONCURRENT_RUNS_PER_USER=4
MAX_MODEL_COST_USD_PER_RUN=25
