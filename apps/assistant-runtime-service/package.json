{
  "name": "assistant-runtime-service",
  "version": "0.0.1",
  "description": "Assistant agent runtime service",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "dev": "nest start --watch",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:compatibility": "vitest run src/compatibility/assistant-contract-fixtures.spec.ts",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.mts",
    "test:migrations": "pnpm build && vitest run --config ./vitest.config.migrations.mts",
    "test:repositories": "vitest run --config ./vitest.config.repositories.mts",
    "test:transactions": "vitest run --config ./vitest.config.transactions.mts",
    "migration:run": "pnpm build && typeorm migration:run -d dist/infrastructure/database/assistant-runtime-migration-data-source.js",
    "migration:revert": "pnpm build && typeorm migration:revert -d dist/infrastructure/database/assistant-runtime-migration-data-source.js",
    "migration:show": "pnpm build && typeorm migration:show -d dist/infrastructure/database/assistant-runtime-migration-data-source.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/terminus": "12.1.0",
    "@repo/contracts": "workspace:*",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "10.9.1",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  }
}
