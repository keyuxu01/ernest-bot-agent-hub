# =============================================================================
# Agent Hub · Compose 环境变量模板（本地 podman compose / 上机可 docker compose）
# =============================================================================
#
# 根目录 env 分工（基础设施 compose 专用，与 apps/*/.env 分离）：
#   .env.example       本文件 · 模板 + 注释（提交）
#   .env.dev           本地默认值（提交，弱密码 OK）
#   .env.prod.example  上机占位 CHANGE_ME（提交）
#   .env.prod.local    上机真密码（gitignore，cp .env.prod.example 后改）
#   .env               个人本地覆盖（gitignore，可选，手动 --env-file 叠加）
#
# 使用：
#   本地  pnpm docker:up
#   上机  cp .env.prod.example .env.prod.local && 编辑 → pnpm docker:up:prod
#
# 应用连接（进程跑在宿主机、基础设施在 compose 内）：
#   Postgres  postgresql://user:PASSWORD@localhost:5432/agent_hub
#   MongoDB   mongodb://agent_hub:PASSWORD@localhost:27017/knowledge_hub?authSource=knowledge_hub
#   Redis     redis://localhost:6379
#   RabbitMQ  amqp://USER:PASS@localhost:5672/
#   ES        http://localhost:9200
#   RustFS    S3 endpoint http://localhost:9000
#   Neo4j     bolt://localhost:7687（用户 neo4j）
# =============================================================================

# -----------------------------------------------------------------------------
# 数据卷存储路径
# -----------------------------------------------------------------------------
# 所有 compose 服务的持久化数据：${DOCKER_VOLUME_DIRECTORY}/volumes/…
# 本地可用 "."；上机建议绝对路径，如 /data/agent-hub
DOCKER_VOLUME_DIRECTORY=.

# -----------------------------------------------------------------------------
# PostgreSQL（pgvector）
# -----------------------------------------------------------------------------
# Web：pgAdmin http://localhost:8088
POSTGRES_USER=user
POSTGRES_PASSWORD=
POSTGRES_DB=agent_hub

# -----------------------------------------------------------------------------
# pgAdmin
# -----------------------------------------------------------------------------
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=

# -----------------------------------------------------------------------------
# MongoDB
# -----------------------------------------------------------------------------
# Web：mongo-express http://localhost:8081（登录 me_admin / me_123456，见 compose）
MONGO_INITDB_ROOT_USERNAME=mongo_user
MONGO_INITDB_ROOT_PASSWORD=
MONGO_INITDB_DATABASE=knowledge_hub
MONGO_APP_USERNAME=agent_hub
MONGO_APP_PASSWORD=

# -----------------------------------------------------------------------------
# RabbitMQ
# -----------------------------------------------------------------------------
# 管理台 http://localhost:15672
# 上机勿使用 guest；需与 docker-compose 中 RABBITMQ_DEFAULT_* 一致
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=

# -----------------------------------------------------------------------------
# RustFS（S3 兼容对象存储）
# -----------------------------------------------------------------------------
# API :9000 · 控制台 http://localhost:9001
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=

# -----------------------------------------------------------------------------
# Neo4j（知识图谱）
# -----------------------------------------------------------------------------
# Web http://localhost:7474 · Bolt bolt://localhost:7687
# 账号固定为 neo4j，密码由本变量设置
NEO4J_PASSWORD=
