{
  "$schema": "https://github.com/dyoshikawa/rulesync/releases/latest/download/config-schema.json",

  "targets": {
    "claudecode": {
      "rules": {
        "ruleDiscoveryMode": "explicit",
      },
      "commands": false,
      "skills": true,
    },

    "cursor": {
      "rules": true,
      "commands": false,
      "skills": true,
    },

    "codexcli": {
      "rules": true,
      "commands": false,
      "skills": true,
    },

    "agentsmd": {
      "rules": true,
      "commands": false,
      "skills": false,
    },
  },

  "sources": [
    {
      "source": "https://github.com/vercel-labs/agent-skills.git",
      "transport": "git",
      "skills": ["react-best-practices"],
    },
    {
      "source": "https://github.com/shadcn-ui/ui.git",
      "transport": "git",
      "skills": ["shadcn"],
    },
    {
      "source": "https://github.com/vercel/ai.git",
      "transport": "git",
      "skills": ["use-ai-sdk"],
    },
    {
      "source": "https://github.com/vercel/turborepo.git",
      "transport": "git",
      "skills": ["turborepo"],
    },
    {
      "source": "https://github.com/modelcontextprotocol/ext-apps.git",
      "transport": "git",
      "path": "plugins/mcp-apps/skills",
      "skills": [
        "create-mcp-app",
        "add-app-to-server",
        "migrate-oai-app",
        "convert-web-app",
      ],
    },
    {
      "source": "https://github.com/openai/plugins.git",
      "transport": "git",
      "path": "plugins/openai-developers/skills",
      "skills": ["build-chatgpt-app", "chatgpt-app-submission"],
    },
  ],

  "outputRoots": ["."],

  "delete": true,
  "verbose": true,
  "silent": false,
}
