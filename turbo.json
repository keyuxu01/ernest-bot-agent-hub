{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": [
    "NODE_ENV",
    "API_BASE_URL",
    "NEXT_PUBLIC_API_BASE_URL",
    "PORT",
    "POSTGRES_HOST",
    "POSTGRES_PORT",
    "POSTGRES_USER",
    "POSTGRES_PASSWORD",
    "POSTGRES_DB",
    "MONGO_URI",
    "SNOWFLAKE_OFFSET",
    "SNOWFLAKE_WORKER_ID",
    "ASSISTANT_RUNTIME_URL",
    "USER_PLATFORM_URL",
    "SERVICE_VERSION",
    "SERVICE_BUILD_ID",
    "CLI_VERSION",
    "CLI_BUILD_ID",
    "OAUTH_CALLBACK_PORT",
    "CREDENTIAL_STORE_SERVICE",
    "CREDENTIAL_STORE_ACCOUNT",
    "CLI_REQUEST_TIMEOUT_MS",
    "LOCAL_TOOL_TIMEOUT_MS",
    "LOCAL_TOOL_MAX_OUTPUT_BYTES",
    "MCP_COLLECTIONS_URL",
    "POSTGRES_SCHEMA",
    "POSTGRES_POOL_SIZE",
    "POSTGRES_SSL",
    "REDIS_URL",
    "REDIS_KEY_PREFIX",
    "REDIS_HOT_STATE_TTL_SECONDS",
    "REDIS_LEASE_TTL_MS",
    "REDIS_LEASE_RENEW_INTERVAL_MS",
    "REDIS_COMMAND_TIMEOUT_MS",
    "MEM0_MODE",
    "MEM0_API_KEY",
    "MEM0_AGENT_ID",
    "MEM0_TOP_K",
    "MEM0_REQUEST_TIMEOUT_MS",
    "MEM0_EXTRACTION_ENABLED",
    "OBJECT_STORAGE_ENDPOINT",
    "OBJECT_STORAGE_BUCKET",
    "OBJECT_STORAGE_ACCESS_KEY_ID",
    "OBJECT_STORAGE_SECRET_ACCESS_KEY",
    "OBJECT_STORAGE_REQUEST_TIMEOUT_MS",
    "ENCRYPTION_KEY_ID",
    "ENCRYPTION_MASTER_KEY",
    "MODEL_REQUEST_TIMEOUT_MS",
    "MODEL_MAX_ATTEMPTS",
    "MCP_REQUEST_TIMEOUT_MS",
    "MAX_REQUEST_BYTES",
    "MAX_STREAM_SECONDS",
    "MAX_CONCURRENT_RUNS_PER_USER",
    "MAX_MODEL_COST_USD_PER_RUN",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "GOOGLE_ISSUER",
    "GOOGLE_AUTHORIZATION_URL",
    "GOOGLE_TOKEN_URL",
    "GOOGLE_JWKS_URL",
    "OAUTH_ALLOWED_REDIRECT_URIS",
    "OAUTH_STATE_TTL_SECONDS",
    "SIGNING_KEY_ID",
    "SIGNING_PRIVATE_KEY",
    "SIGNING_PUBLIC_KEY",
    "TOKEN_ALGORITHM",
    "TOKEN_ISSUER",
    "TOKEN_AUDIENCE",
    "TOKEN_PUBLIC_KEY",
    "TOKEN_KEY_ID",
    "ACCESS_TOKEN_TTL_SECONDS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^build", "^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
