# =============================================================================
# Agent Hub · 本地开发（可提交仓库）· Podman Compose 专用
# =============================================================================
#
# 启动：pnpm docker:up
#       podman compose --env-file .env.dev up -d --build
#
# 分工见 .env.example（.env.dev / .env.prod.example / .env.prod.local / .env）
# 各 app 业务 env 见 apps/*/.env.dev（可提交）或 .env.local（覆盖）；
# 例如雪花 ID：apps/agentic-rag-business-service/.env.dev 的 SNOWFLAKE_*。
# DATABASE_URL 等连 compose 时用 localhost:端口。
#
# 管理界面（默认账号见下 / compose 内 mongo-express 基本认证）：
#   pgAdmin :8088 · mongo-express :8081 · RedisInsight :5540
#   RabbitMQ :15672 · Kibana :5601 · RustFS :9001 · Neo4j :7474
# =============================================================================

# -----------------------------------------------------------------------------
# 数据卷存储路径
# -----------------------------------------------------------------------------
DOCKER_VOLUME_DIRECTORY=.

# -----------------------------------------------------------------------------
# PostgreSQL（pgvector）— localhost:5432
# -----------------------------------------------------------------------------
POSTGRES_USER=user
POSTGRES_PASSWORD=123456
POSTGRES_DB=agent_hub

# -----------------------------------------------------------------------------
# pgAdmin — http://localhost:8088
# -----------------------------------------------------------------------------
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin

# -----------------------------------------------------------------------------
# MongoDB — localhost:27017
# -----------------------------------------------------------------------------
MONGO_INITDB_ROOT_USERNAME=mongo_user
MONGO_INITDB_ROOT_PASSWORD=mongo_pass123
MONGO_INITDB_DATABASE=knowledge_hub
MONGO_APP_USERNAME=agent_hub
MONGO_APP_PASSWORD=agent_hub_password

# -----------------------------------------------------------------------------
# RabbitMQ — AMQP :5672 · 控制台 http://localhost:15672
# -----------------------------------------------------------------------------
# guest 仅适合本地；上机请用 .env.prod
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# -----------------------------------------------------------------------------
# RustFS — S3 http://localhost:9000 · 控制台 http://localhost:9001
# -----------------------------------------------------------------------------
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin

# -----------------------------------------------------------------------------
# Neo4j — bolt://localhost:7687 · 用户 neo4j
# -----------------------------------------------------------------------------
NEO4J_PASSWORD=12345678
